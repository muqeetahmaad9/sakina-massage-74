DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
PORT=5000

# Set to "production" when deployed — enables Secure/SameSite=None session cookies required
# for a cross-domain frontend (e.g. Vercel) talking to this backend (e.g. Render).
NODE_ENV="development"

# Comma-separated list of frontend origins allowed to call this API (CORS).
FRONTEND_ORIGINS="http://localhost:5174"

# Email notifications (Resend) — leave RESEND_API_KEY empty to skip real sending (logs instead)
RESEND_API_KEY=""
NOTIFY_EMAIL="you@example.com"
FROM_EMAIL="Sakina Massage 974 <onboarding@resend.dev>"

# Used to build links inside emails (e.g. password reset). Update to the deployed frontend URL.
FRONTEND_BASE_URL="http://localhost:5174"
